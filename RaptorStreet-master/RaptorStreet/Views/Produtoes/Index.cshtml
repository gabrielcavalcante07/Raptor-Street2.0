@model IEnumerable<RaptorStreet.Models.Produto>

@{
    ViewBag.ExibirNavbar = false;
}

<body>
<div class="container text-white py-4">
    <h1 class="mb-4 text-center">Lista de Produtos</h1>
    <div class="text-center">
        <a class="btn btn-dark mb-4" asp-controller="Adms" asp-action="Dashboard">Voltar</a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card bg-dark text-white h-100 border border-secondary shadow-sm">
                    <img src="@item.ImagemProduto" class="card-img-top" alt="Imagem do Produto" style="object-fit: cover; height: 200px;" />

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="card-info d-flex flex-column align-items-center text-center py-3">
                            <h5 class="card-title">@item.NomeProduto</h5>
                            <p class="card-text"><strong>Preço:</strong> R$ @item.PrecoProduto</p>
                            <p class="card-text"><strong>Descrição:</strong> @item.Descricao</p>
                            <p class="card-text"><strong>Marca:</strong> @item.MarcaProdutos.NomeMarca</p>
                        </div>

                        <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.IdProduto">Editar</a>
                            <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.IdProduto">Detalhes</a>
                            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#exampleModal-@item.IdProduto">Excluir</button>
                        </div>
                    </div>
                </div>

                <!-- Modal de exclusão -->
                <div class="modal fade" id="exampleModal-@item.IdProduto" tabindex="-1" aria-labelledby="exampleModalLabel-@item.IdProduto" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel-@item.IdProduto">Excluir Produto?</h1>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Você realmente deseja excluir o produto <strong>@item.NomeProduto</strong>?</p>
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-route-id="@item.IdProduto" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <input type="submit" value="Excluir" class="btn btn-danger" />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
</body>