@model ResumoPedido

<div class="container text-white mt-3 ">

    <h1>Resumo do Pedido</h1>

    <div>
        <h4>Dados do Cliente</h4>
        <p><strong>Nome:</strong> @Model.Cliente.NomeCliente</p>
        <p><strong>Email:</strong> @Model.Cliente.EmailCliente</p>
        <p><strong>CPF:</strong> @Model.Cliente.CPF</p>
    </div>
    <div class="painel-card bg-dark">
        <h3 class="text-white">Adicionar Novo Endereço</h3>
        <form asp-action="AdicionarEndereco" method="post" class="painel-form">
            <input type="hidden" name="idCliente" value="@Model.Cliente.IdCliente" />

            <div class="form-grid">
                <input type="text" name="CEP" placeholder="CEP" required maxlength="9" oninput="formatarCEP(this)" />
                <input type="text" name="Logradouro" placeholder="Logradouro" required />
                <input type="number" name="NumeroEndereco" placeholder="Número" required />
                <input type="text" name="Complemento" placeholder="Complemento" />
                <input type="text" name="Bairro" placeholder="Bairro" required />
                <input type="text" name="Cidade" placeholder="Cidade" required />
                <input type="text" name="Estado" placeholder="Estado" required />
            </div>
            <button type="submit" class="btn-adicionar">Adicionar Endereço</button>
        </form>
    </div>

    <form method="post" asp-action="ConfirmarPedido" class="d-flex flex-column">
        <p><strong>Endereço:</strong></p>
        <select class="form-select" required>
            @foreach (var enderecoCliente in Model.Cliente.ClienteEnderecos)
            {
                <option disabled selected value="">Selecione um endereço</option>
                <option value="@enderecoCliente.IdEnd">
                    @enderecoCliente.Enderecos.Logradouro, nº @enderecoCliente.Enderecos.NumeroEndereco,
                    Bairro: @enderecoCliente.Enderecos.Bairro,
                    @enderecoCliente.Enderecos.Cidade - @enderecoCliente.Enderecos.Estado, CEP: @enderecoCliente.Enderecos.CEP
                    @if (!string.IsNullOrEmpty(enderecoCliente.Enderecos.Complemento))
                    {
                        <text>, Complemento: @enderecoCliente.Enderecos.Complemento</text>
                    }
                </option>
            }
        </select>


        <h4 class="mt-5">Produtos no Carrinho</h4>
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Produto</th>
                    <th>Tamanho</th>
                    <th>Qtd</th>
                    <th>Preço Unit.</th>
                    @* <th>Total</th> *@
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Produtos)
                {
                    <tr>
                        <td><img src="@item.ImagemProduto" alt="Imagem do Produto" width="100" height="100" style="object-fit: cover;" /></td>
                        <td>@item.NomeProduto</td>
                        <td>@item.Tamanho</td>
                        <td>@item.QuantidadeProd</td>
                        <td>@item.PrecoProduto.ToString("C")</td>
                        @* <td>@(item.PrecoProduto * item.QuantidadeProd).ToString("C")</td> *@            
                            </tr>
                }
            </tbody>
        </table>

        <h4 class="text-success"><strong class="text-white">Total:</strong> @Model.Total.ToString("C")</h4>
        <div class="d-flealign-content-xl-around justify-content-start w-25 gap-2">
            <select name="Fk_IdPag" class="form-select" required>
                <option disabled selected hidden value="">Escolha a forma de pagamento</option>
                <option value="1">Cartão</option>
                <option value="2">Pix</option>
                <option value="3">Boleto</option>
            </select>
            <button type="submit" class="btn btn-success w-100 mt-2">Confirmar Pedido</button>
        </div>
    </form>
</div>
