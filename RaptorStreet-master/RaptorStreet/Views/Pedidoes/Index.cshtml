@model IEnumerable<RaptorStreet.Models.Pedido>

<div class="container text-white">

	<h1>Index</h1>

	<table class="table table-dark">
		<thead>
			<tr>
				<th>Cliente</th>
				<th>Pedido</th>
				<th>Endereço</th>
				<th>Forma de Pagamento</th>
				<th>Total</th>
				<th>Data do Pedido</th>
				<th>Ações</th>
			<tr />
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr class="bg-white text-center">
					<td>
						@item.Clientes.NomeCliente
					</td>

					<td>
						@foreach (var produto in item.ItemPedidos)
						{
							<div>
								<strong>@produto.NomeProduto</strong>
							</div>
						}
					</td>


					<td>
						@item.Enderecos.Logradouro, Nº @item.Enderecos.NumeroEndereco, @item.Enderecos.Bairro - @item.Enderecos.Cidade/@item.Enderecos.Estado
					</td>

					<td>
					@item.Pagamentos.MetodoPag
					</td>

					<td>
						@item.dataPed
					</td>

					<td>
					@item.totalPedido
					</td>

					<td>
						<a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.IdPedido">Details</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
