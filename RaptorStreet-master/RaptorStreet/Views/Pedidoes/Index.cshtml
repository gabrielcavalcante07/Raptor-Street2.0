@model IEnumerable<RaptorStreet.Models.Pedido>


<div class="painel-container" style="padding-top:100px;">
	<aside class="sidebar text-white">
		<img src="~/assets/img/dinossauro-beje.png" alt="Logo" class="sidebar-logo" />
		<h2 class="sidebar-title">Área do Usuário</h2>
		<ul class="sidebar-menu">
			<li><a href="~/Clientes/Painel">Conta</a></li>
			<li><a href="~/Favoritar">Favoritos</a></li>
			<li><a href="~/Pedidoes/Index">Histórico de compras</a></li>
			<li>Ajuda</li>
		</ul>
		<button class="btn-voltar" onclick="location.href='/home/index'">Voltar</button>
	</aside>

	<main class="painel-conteudo ">
		<h2 class="titulo-bemvindo">Meus Pedidos</h2>
<div class="container text-white">
	<table class="table table-dark">
		<thead>
			<tr>
				<th>Cliente</th>
				<th>N° Pedido</th>
				<th>Endereço</th>
				<th>Forma de Pagamento</th>
				<th>Data do Pedido</th>
				<th>Total</th>
				<th>Ações</th>
			<tr />
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr class="bg-white text-center">
					<td>
						@item.Clientes.NomeCliente
					</td>

					<td>
						@foreach (var produto in item.ItemPedidos)
						{
							<div>
								<strong>@produto.Fk_IdPedido</strong>
							</div>
						}
					</td>


					<td>
						@item.Enderecos.Logradouro, Nº @item.Enderecos.NumeroEndereco, @item.Enderecos.Bairro - @item.Enderecos.Cidade/@item.Enderecos.Estado
					</td>

					<td>
					@item.Pagamentos.MetodoPag
					</td>

					<td>
						@item.dataPed
					</td>

					<td>
					@item.totalPedido
					</td>

					<td>
						<a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.IdPedido">Details</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
</main>
</div>
