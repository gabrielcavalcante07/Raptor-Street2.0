@{
	var emailCliente = Context.Session.GetString("EmailCliente");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Raptor Street</title>
	<link rel="shortcut icon" href="~/assets/img/logo.png" type="image/x-icon">
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/RaptorStreet.styles.css" asp-append-version="true" />
	<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;400&family=Staatliches&display=swap" rel="stylesheet">
</head>
<body>
	<header>
		@if (ViewBag.ExibirNavbar != false)
		{
			<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark custom-navbar mb-3 fixed-top">
				<div class="container-fluid justify-content-between mx-4">
					<div class="logo">
						<img src="~/assets/img/logo-combination.copy.png" class="logo-desktop d-none d-md-block" onclick="location.href='/home/Index'">
						<img src="~/assets/img/logo.png" class="logo-mobile d-md-none" onclick="location.href='/home/Index'" />
					</div>


					<!-- Botão Hamburguer (visível apenas em telas pequenas) -->
					<div class="d-sm-none">
						<button class="navbar-toggler d-inline-block d-sm-none me-2"
								type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar"
								aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
							<span class="navbar-toggler-icon"></span>
						</button>



						<!-- Offcanvas Menu -->
						<div class="offcanvas offcanvas-start  bg-black text-white" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
							<div class="offcanvas-header">
								<h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">Menu</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"
										aria-label="Close"></button>
							</div>
							<div class="offcanvas-body">
								<ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
									<li class="nav-item">
										<a onclick="location.href='/home/Index'" class="nav-link active" style="background-color: #dc3545">Inicio</a>
									</li>
									<li class="nav-item dropdown">
										<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
											Marcas
										</a>
										<ul class="dropdown-menu dropdown-menu-dark">
											<li><a asp-controller="Home" asp-action="Marca" asp-route-nome="Vans" class="dropdown-item">Vans</a></li>
											<li><a asp-controller="Home" asp-action="Marca" asp-route-nome="Adidas" class="dropdown-item">Adidas</a></li>
											<li><a asp-controller="Home" asp-action="Marca" asp-route-nome="Mizuno" class="dropdown-item">Mizuno</a></li>
											<li><a asp-controller="Home" asp-action="Marca" asp-route-nome="Nike" class="dropdown-item">Nike</a></li>
											<li><a asp-controller="Home" asp-action="Marca" asp-route-nome="Puma" class="dropdown-item">Puma</a></li>
										</ul>
									</li>
								</ul>



								<div class="search-container s2">
									<form class="d-flex" asp-controller="Home" asp-action="Pesquisar" method="get" role="search">
										<img src="~/assets/icons/icon-search-dark.svg" id="icon-search" />
										<input class="form-control" type="search" name="nome" placeholder="Pesquisar" aria-label="Search">
									</form>
								</div>
							</div>
						</div>
					</div>


					@*input search*@
					<div class="search-container s1">
						<form class="d-flex" asp-controller="Home" asp-action="Pesquisar" method="get" role="search">
							<img src="~/assets/icons/icon-search-dark.svg" id="icon-search" />
							<input class="form-control" type="search" name="nome" placeholder="Pesquisar" aria-label="Search">
						</form>
					</div>

					<div class="d-flex justify-content-center align-items-center ">
						@* Se cliente está logado *@
						@if (!string.IsNullOrEmpty(emailCliente))
						{
							<div class="nav-item dropdown">
								<a class="nav-link" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<img src="~/assets/icons/icon-perfil.svg" id="perfil" class="rounded-circle" object-fit: cover;" />
								</a>
								<ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" aria-labelledby="perfilDropdown">
									<li><a class="dropdown-item" asp-controller="Clientes" asp-action="Painel">Painel do Cliente</a></li>
									<li><a class="dropdown-item" asp-controller="ClienteFavs" asp-action="Favoritar">Favoritos</a></li>
									<li><a class="dropdown-item" asp-controller="Pedidoes" asp-action="Index">Histórico de pedidos</a></li>
									<li><a class="dropdown-item" asp-controller="Clientes" asp-action="Ajuda">Ajuda</a></li>
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" asp-controller="Logins" asp-action="Logout">Sair</a></li>
								</ul>
							</div>
						}
						else
						{
							<a class="btn btn-danger " asp-controller="Logins" asp-action="Login">Login</a>
						}

						@*icon cart*@
						<a style="margin-left: 1vh;" asp-controller="Pedidoes" asp-action="Carrinho"><img src="~/assets/icons/icon-cart.svg" id="cart" /></a>

					</div>
				</div>

				@*navbar marcas*@
				<div class="nav-marcas">
					<a asp-controller="Home" asp-action="Marca" asp-route-nome="Vans"><img src="~/assets/img/vans.png" id="Vans" class="nav-marcas-icons" /></a>
					<a asp-controller="Home" asp-action="Marca" asp-route-nome="Adidas"><img src="~/assets/img/adidas.png" id="Adidas" class="nav-marcas-icons" /></a>
					<a asp-controller="Home" asp-action="Marca" asp-route-nome="Mizuno"><img src="~/assets/img/mizuno.png" id="Mizuno" class="nav-marcas-icons" /></a>
					<a asp-controller="Home" asp-action="Marca" asp-route-nome="Nike"><img src="~/assets/img/nike.png" id="Nike" class="nav-marcas-icons" /></a>
					<a asp-controller="Home" asp-action="Marca" asp-route-nome="Puma"><img src="~/assets/img/puma.png" id="Puma" class="nav-marcas-icons" /></a>
				</div>

			</nav>
		}
	</header>
	<div class="container-fluid p-0">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="footer text-muted">
		<div class="text-center">
			&copy; 2024 - Raptor Street
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
