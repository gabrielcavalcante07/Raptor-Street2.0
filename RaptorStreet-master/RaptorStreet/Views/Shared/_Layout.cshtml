@{
	var emailCliente = Context.Session.GetString("EmailCliente");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Raptor Street</title>
	<link rel="shortcut icon" href="~/assets/img/logo.png" type="image/x-icon">
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/RaptorStreet.styles.css" asp-append-version="true" />
	<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;400&family=Staatliches&display=swap" rel="stylesheet">
</head>
<body>
	<header>
		@if (ViewBag.ExibirNavbar != false)
		{
			<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark custom-navbar mb-3 fixed-top">
				<div class="container-fluid justify-content-between mx-4">
					<div class="logo">
						<a class="navbar-brand navbar-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/assets/img/logo-combination.copy.png" /></a>
							<a class="" asp-area="" asp-controller="Home" asp-action="Filtro">Produtos</a>
					</div>

					@*input search*@
					<div class="search-container">
						<form class="d-flex" asp-controller="Home" asp-action="Pesquisar" method="get" role="search">
							<img src="~/assets/icons/icon-search-dark.svg" id="icon-search" />
							<input class="form-control" type="search" name="nome" placeholder="Pesquisar" aria-label="Search">
						</form>
					</div>


					<div class="d-flex gap-3 justify-content-center align-items-center">
						@* Se cliente está logado *@
						@if (!string.IsNullOrEmpty(emailCliente))
						{
							<div class="nav-item dropdown">
								<a class="nav-link" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<img src="~/assets/img/perfil.png" id="perfil" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
								</a>
								<ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" aria-labelledby="perfilDropdown">
									<li><a class="dropdown-item" asp-controller="Clientes" asp-action="Painel">Painel do Cliente</a></li>
									<li><a class="dropdown-item" asp-controller="Clientes" asp-action="Favoritos">Favoritos</a></li>
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" asp-controller="Logins" asp-action="Logout">Sair</a></li>
								</ul>
							</div>
						}
						else
						{
							<a class="btn btn-danger" asp-area="" asp-controller="Logins" asp-action="Login">Login</a>
						}

						@*icon cart*@
						<a asp-area="" asp-controller="Pedidoes" asp-action="Carrinho"><img src="~/assets/icons/icon-cart.svg" id="cart" /></a>

					</div>
				</div>

					@*navbar marcas*@
					<div class="nav-marcas">
						<a asp-controller="Produtoes" asp-action="Vans"><img src="~/assets/img/vans.png" id="Vans" class="nav-marcas-icons" /></a>
						<a asp-controller="Produtoes" asp-action="Adidas"><img src="~/assets/img/adidas.png" id="Adidas" class="nav-marcas-icons" /></a>
						<a asp-controller="Produtoes" asp-action="Mizuno"><img src="~/assets/img/mizuno.png" id="Mizuno" class="nav-marcas-icons" /></a>
						<a asp-controller="Produtoes" asp-action="Nike"><img src="~/assets/img/nike.png" id="Nike" class="nav-marcas-icons" /></a>
						<a asp-controller="Produtoes" asp-action="Puma"><img src="~/assets/img/puma.png" id="Puma" class="nav-marcas-icons" /></a>
					</div>

					@*menu-hamburguer*@
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
							aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
			</nav>
		}
	</header>
	<div class="container-fluid p-0">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="footer text-muted">
		<div class="text-center">
			&copy; 2024 - Raptor Street
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
