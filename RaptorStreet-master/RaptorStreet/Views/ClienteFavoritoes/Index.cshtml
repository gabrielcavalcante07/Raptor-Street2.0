@model IEnumerable<RaptorStreet.Models.ClienteFav>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ativado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Clientes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Produtos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ativado)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Clientes.IdCliente)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Produtos.IdProduto)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdClienteFav">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.IdClienteFav">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdClienteFav">Delete</a>
                </td>
            </tr>
        }







        <section class="wishlist">
            <h2>Wishlist</h2>
            <div class="wishlist-container">

                @foreach (var favorito in ViewBag.clienteFavoritos as List<ClienteFav>)
                {
                    var produto = favorito.Produtos;
                    <div class="wishlist-item">

                        <img class="img-prod-fav" src="~/img/produtos/labios/gloss/marimaria.png" alt="Imagem do Produto" />
                        <form asp-controller="ClienteFavoritoes" asp-action="Desfavoritar" method="post">
                            <input type="hidden" name="idProd" value="@produto.IdProduto" />
                            <!-- icon do produro coração -->
                            <button type="submit" class="btn-favoritar">
                                <img class="icons-prod" src="~/img/favs-icon.png" alt="favoritos">
                            </button>
                        </form>
                        <h3>@produto.NomeProduto</h3>
                        <p class="preco">R$ @produto.PrecoProduto.ToString("N2")</p>
                        <p class="parcelamento">
                            Em até 1x R$ @produto.PrecoProduto.ToString("N2") sem juros
                        </p>
                        <a class="btn-favs"> <img class="icons-prodCompra" src="~/img/icon-shopping-prod.png" alt="favoritos" />Comprar</a>
                    </div>
                }
            </div>
        </section>

    </tbody>
</table>
