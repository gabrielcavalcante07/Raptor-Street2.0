@model RaptorStreet.Models.Cliente

@{
    ViewBag.ExibirNavbar = false;
}

<div class="container text-center text-white">

    <h1>Cadastrar Cliente</h1>
    <div class="row justify-content-center">
        <div class="col-md-4 text-white text-start">
            <form asp-action="Create" onsubmit="limparFormatacao()">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="NomeCliente" class="control-label"></label>
                    <input asp-for="NomeCliente" class="form-control" placeholder="Nome Completo" required />
                    <span asp-validation-for="NomeCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DataNascimento" class="control-label"></label>
                    <input asp-for="DataNascimento" class="form-control" type="date" required />
                    <span asp-validation-for="DataNascimento" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CPF" class="control-label"></label>
                    <input asp-for="CPF" class="form-control" placeholder="CPF" maxlength="14" oninput="formatarCPF(this)" required />
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Telefone" class="control-label"></label>
                    <input asp-for="Telefone" class="form-control" placeholder="Telefone" maxlength="15" oninput="formatarTelefone(this)" required />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>

                <div class="form-group" style="position: relative;">
                    <label asp-for="SenhaCliente" class="control-label"></label>
                    <input asp-for="SenhaCliente" class="form-control" placeholder="Senha" type="password" id="senhaInput" style="padding-right: 40px;" required />
                    <button type="button" onclick="toggleSenha()" style="position: absolute; right: 10px; top: 32px; background: none; border: none; color: #ccc;">
                        <i id="senhaToggleIcon" class="fa-solid fa-eye-slash"></i>
                    </button>
                    <span asp-validation-for="SenhaCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EmailCliente" class="control-label"></label>
                    <input asp-for="EmailCliente" class="form-control" placeholder="E-mail" type="email" required />
                    <span asp-validation-for="EmailCliente" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <a asp-controller="Adms" asp-action="Dashboard" class="btn btn-dark">Voltar</a>
                    <input type="submit" value="Cadastrar" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    }
</div>