@model IEnumerable<RaptorStreet.Models.Produto>

@{
	ViewData["Title"] = "Carrinho";
	decimal total = 0;
}


	<div class="container mt-4">
		<h1 class="mb-4" style="color: white">CARRINHO</h1>

		@if (Model == null || !Model.Any())
		{
			<div class="container text-center text-white">
				<p>Carrinho está vazio</p>
			</div>
		}
		else
		{
			<div class="row">
				@foreach (var item in Model)
				{
					var subTotal = item.QuantidadeProd * item.PrecoProduto;
					total += subTotal;

					<div class="col-md-8">
						<div class="card mb-4">
							<div class="card-body">
								<h2 class="h5 mb-3">PRODUTO</h2>
								<div class="row">
									<div class="col-3">
										<img src="@item.ImagemProduto" class="product-image" alt="@item.NomeProduto" style="width: 150px;height: 100px;">
									</div>
									<div class="col-6">
										<p class="mb-1 fw-bold">@item.NomeProduto</p>
										<p class="mb-1 text-muted">@item.Descricao</p>
										<p class="mb-1 text-muted">Tamanho: @item.Tamanho</p>
									</div>
									<div class="col-3 text-end">
										<button class="btn btn-sm btn-outline-danger" onclick="confirmRemove('@item.IdProduto')">EXCLUIR</button>
									</div>
								</div>
							</div>
						</div>

						<div class="card mb-4">
							<div class="card-body">
								<div class="row align-items-center">
									<div class="col-md-4">
										<h3 class="h6">QUANTIDADE</h3>
										<div class="d-flex align-items-center">
											<form asp-action="DiminuirItem" asp-controller="Carrinho" method="post">
												<input type="hidden" name="id" value="@item.IdProduto" />
												<button type="submit" class="btn btn-outline-secondary btn-sm">-</button>
											</form>
											<div class="px-3 py-1 mx-2 border">@item.QuantidadeProd</div>
											<form asp-action="AdicionarItem" asp-controller="Carrinho" method="post">
												<input type="hidden" name="id" value="@item.IdProduto" />
												<button type="submit" class="btn btn-outline-secondary btn-sm">+</button>
											</form>
										</div>
									</div>

									<div class="col-md-4">
										<h3 class="h6">VALOR UNITÁRIO</h3>
										<p class="mb-0">@item.PrecoProduto.ToString("C")</p>
									</div>

									<div class="col-md-4">
										<h3 class="h6">SUBTOTAL</h3>
										<p class="mb-0 fw-bold">@subTotal.ToString("C")</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
				<!-- Resumo -->
				<div class="col-md-4">
					<div class="card mb-3">
						<div class="card-body">
							<h2 class="h5 mb-3">RESUMO DA COMPRA</h2>
							<div class="d-flex justify-content-between mb-2">
								<span>Valor dos produtos</span>
								<span>@total.ToString("C")</span>
							</div>
							<hr>
							<div class="d-flex justify-content-between fw-bold">
								<span>Total</span>
								<span>@total.ToString("C")</span>
							</div>
						</div>
					</div>

					<a class="btn btn-dark w-100 py-2 mb-2" asp-controller="Carrinho" asp-action="FinalizarCompra">Finalizar Compra</a>
				</div>
			</div>
		}
	</div>


<script>
	function confirmRemove(id) {
		Swal.fire({
			title: 'Você tem certeza?',
			text: 'Deseja remover este item do carrinho?',
			icon: 'warning',
			showCancelButton: true,
			confirmButtonText: 'Sim, remover!',
			cancelButtonText: 'Cancelar'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '@Url.Action("RemoverItem", "Carrinho")',
					type: 'POST',
					data: { id: id },
					success: function (response) {
						if (response.success) {
							location.reload();
						} else {
							Swal.fire('Erro', 'Não foi possível remover o item.', 'error');
						}
					}
				});
			}
		});
	}
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

