@{
    ViewData["Title"] = "Nike";
}


<body>
    <section style="padding-top: 100px;">
        <h1 class="text-white text-center mt-3">NIKE</h1>

        <div class="row">
            <div class="col-md-3">
                <div class="filter-sidebar">
                    <div class=""></div>
                    <h2 class="filter-title">Filtros</h2>
                    <div class="filter-group">
                        <label class="filter-title">Preço</label>
                        <label><input type="checkbox"> Menos de R$500</label><br>
                        <label><input type="checkbox"> R$500 - R$1000</label><br>
                        <label><input type="checkbox"> Mais de R$1000</label>
                    </div>
                    <div class="filter-group">
                        <label class="filter-title">Cor</label>
                        <label><input type="checkbox"> Preto</label><br>
                        <label><input type="checkbox"> Branco</label><br>
                        <label><input type="checkbox"> Vermelho</label>
                    </div>
                    <div class="filter-group">
                        <label class="filter-title">Tamanho</label>
                        <label><input type="checkbox"> 38</label><br>
                        <label><input type="checkbox"> 40</label><br>
                        <label><input type="checkbox"> 42</label>
                    </div>
                    <div class="filter-group">
                        <label class="filter-title">Gênero</label>
                        <label><input type="checkbox"> Masculino</label><br>
                        <label><input type="checkbox"> Feminino</label><br>
                        <label><input type="checkbox"> Unissex</label>
                    </div>
                    <div class="filter-group">
                        <label class="filter-title">Avaliação</label>
                        <label><input type="checkbox"> ★★★★★</label><br>
                        <label><input type="checkbox"> ★★★★☆</label><br>
                        <label><input type="checkbox"> ★★★☆☆</label>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="product-grid">
                    @foreach (var produto in ViewBag.ProdutosDoBanco as List<Produto>)
                    {
                        <div class="product-card">
                            <div class="product-image-container">
                                @* <img src="@produto.ImagemUrl" alt="@produto.Nome" class="product-image"> *@
                                <img src="/assets/tenis/tenis-shadow.png">

                                <input type="checkbox" id="fav-@produto.IdProduto" class="fav-checkbox">
                                <label for="fav-@produto.IdProduto" class="fav-button">♥</label>
                            </div>
                            <div class="product-info">
                                <h5 class="product-name">@produto.NomeProduto</h5>
                                <p class="product-price">@produto.PrecoProduto.ToString("C")</p>
                                <a class="btn btn-primary" asp-controller="home" asp-action="Produto" asp-route-id="@produto.IdProduto">Ver mais</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>


        <div class="promotion-banner mt-4">
            <div class="row align-items-center bg-light rounded p-3">
                <div class="col-md-6">
                    <h3>Parcelamos Suas Compras!</h3>
                    <p>Aproveite nossas condições especiais de parcelamento.</p>
                    <a href="#" class="btn btn-success">Saiba Mais</a>
                </div>
                <div class="col-md-6 text-end">
                    <img src="~/assets/img/banner_promo.jpg" alt="Banner de Promoção" class="img-fluid rounded">
                </div>
            </div>
        </div>
    </section>
</body>