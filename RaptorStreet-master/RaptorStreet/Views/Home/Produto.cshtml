@model RaptorStreet.Models.Produto


<body>
    <section style="padding-top: 100px;">
        <div class="product d-flex container align-items-stretch justify-content-around">
            <div class="image-container col-md-6 text-center">
                <img src="@Model.ImagemProduto" class="product-image img-fluid h-100" id="imagem" />
            </div>
            <div class="gap-1 text-white">
                <h1 id="nome">@Model.NomeProduto</h1>
                <h2 class="price" id="preco">@Model.PrecoProduto.ToString("C")</h2>
                <p>10% de Desconto</p>
                <p>Parcelamos em até 10x sem juros</p>
                <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                    <select name="tamanho" class="form-select" aria-label="Default select example" required>
                        <option disabled selected hidden value="">Escolha o tamanho</option>
                        <option value="35">35</option>
                        <option value="36">36</option>
                        <option value="37">37</option>
                        <option value="38">38</option>
                        <option value="39">39</option>
                        <option value="40">40</option>
                        <option value="41">41</option>
                        <option value="42">42</option>
                        <option value="43">43</option>
                        <option value="44">44</option>
                        <option value="45">45</option>
                    </select>
                    <input type="hidden" name="id" value="@Model.IdProduto" />
                    <input type="hidden" name="qtd" value="1" />
                    <button type="submit" class="btn btn-danger mt-2 container" style="margin:">Adicionar ao Carrinho</button>
                </form>
        </div>

        <div class="container my-5 text-white">
            <h3 class="text-center">Sobre o Produto</h3>
            <p class="product-description text-center" id="descricao">
                @Model.Descricao
            </p>
        </div>

    </section>
</body>

                     