@model List<RaptorStreet.Models.Produto> // Namespace completo do seu model

@* @{
    ViewData["Title"] = "Resultados para: " + ViewBag.TermoPesquisa;
} *@

<section style="padding-top: 10vh">

    <h1>Resultados para: <i>@ViewBag.TermoPesquisa</i></h1>

    @if (Model.Any())
    {
        <div class="product-grid">
            @foreach (var produto in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        <img src="@produto.ImagemProduto" alt="@produto.NomeProduto" class="product-image">
                        <input type="checkbox" id="fav-@produto.IdProduto" class="fav-checkbox">
                        <label for="fav-@produto.IdProduto" class="fav-button">♥</label>
                    </div>
                    <div class="product-info">
                        <h5 class="product-name">@produto.NomeProduto</h5>
                        <p class="product-price">@produto.PrecoProduto.ToString("C")</p>
                        <div class="d-flex gap-1">
                            <a class="btn btn-primary" asp-controller="Home" asp-action="Produto" asp-route-id="@produto.IdProduto">
                                Ver mais
                            </a>
                            <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                                <input type="hidden" name="id" value="@produto.IdProduto" />
                                <input type="hidden" name="quantidade" value="1" />
                                <button type="submit" class="btn btn-success">Adicionar ao Carrinho</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Nenhum produto encontrado para "<strong>@ViewBag.TermoPesquisa</strong>". Tente outro termo.
        </div>
    }
</section>
